{
  "id": "/quiz/",
  "name": "QuizMake",
  "short_name": "QuizMake",
  "start_url": "/quiz/",
  "scope": "/quiz/",
  "display": "standalone",
  "theme_color": "#f8fafc",
  "background_color": "#ffffff",
  "share_target": {
    "action": "/quiz/share-image",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "text": "text",
      "url": "url",
      "files": [{ "name": "image", "accept": ["image/png", "image/jpeg", "image/webp", ".png", ".jpg", ".jpeg", ".webp"] }]
    }
  },
  "icons": [
    {
      "src": "icons/icon-192.png?v=20260829-1",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png?v=20260829-1",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png?v=20260829-1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
