# Supabase Project Settings > API から取得します。
# anon key はブラウザに含める公開キーです。service_role key は絶対に設定しないでください。
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# 差分同期V2を有効にするのは認証済み実接続テスト後。未設定時は旧Snapshot同期。
# VITE_QUIZ_RECORD_SYNC_ENABLED=true
# 新環境のLINE設定を確認するまでは現在の値を変更しないでください。
# VITE_LINE_AUTH_PROVIDER=custom:quizmake-line
# 配布時に承認済みの接続先を固定する任意のチェック（VITE_を付けない）。
# QUIZMAKE_EXPECTED_SUPABASE_PROJECT_REF=your-approved-project-ref
